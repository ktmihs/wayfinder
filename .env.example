# Supabase > Project Settings > Database > Connection string > "Session pooler" 탭
# (Direct connection은 IPv6 전용이라 Railway에서 연결이 안 될 수 있음)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# 카카오 개발자 콘솔 > 앱 > 앱 키 > JavaScript 키
# 플랫폼 > Web 에 http://localhost:3000 과 배포 도메인 등록 필요
NEXT_PUBLIC_KAKAO_JS_KEY=
# Tmap 보행자 경로 API — https://openapi.sk.com 앱 생성 후 appKey. 없으면 OSRM(자동차 경로) 폴백
TMAP_APP_KEY=

# Supabase > Project Settings > API Keys
#   SUPABASE_URL        = Project URL (https://xxxx.supabase.co)
#   SUPABASE_SECRET_KEY = "Secret keys" 탭의 키 (sb_secret_...) 또는 legacy service_role 키
# 커버 이미지 업로드에만 사용. 비어 있으면 이미지 업로드 버튼이 비활성화됨.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
